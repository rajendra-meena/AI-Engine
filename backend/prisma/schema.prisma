generator client {
  provider = "prisma-client-py"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TRADER
  VIEWER
}

enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
}

enum TradeDirection {
  LONG
  SHORT
}

enum OrderType {
  MARKET
  LIMIT
  STOP
  STOP_LIMIT
  BRACKET
  COVER
  ICEBERG
}

enum OrderStatus {
  PENDING
  OPEN
  PARTIAL
  FILLED
  CANCELLED
  REJECTED
  EXPIRED
}

enum PredictionDirection {
  BULLISH
  BEARISH
  NEUTRAL
}

enum PredictionStatus {
  PENDING
  ACTIVE
  HIT
  MISS
  STOPLOSS_HIT
  EXPIRED
}

enum LearningRecommendationStatus {
  NEW
  REVIEWING
  APPROVED
  REJECTED
  IMPLEMENTED
  ROLLED_BACK
}

enum MarketRegime {
  TRENDING
  RANGE
  HIGH_VOLATILITY
  LOW_VOLATILITY
  RISK_ON
  RISK_OFF
  RECOVERY
  DEFENSIVE
}

enum ErrorCategory {
  WRONG_DIRECTION
  FALSE_BREAKOUT
  TREND_REVERSAL
  LOW_LIQUIDITY
  NEWS_SHOCK
  UNEXPECTED_VOLATILITY
  WEAK_MTF_ALIGNMENT
  BAD_SUPPORT_RESISTANCE
  PATTERN_FAILURE
  AI_OVERCONFIDENCE
  AI_UNDERCONFIDENCE
  RISK_MODEL_FAILURE
  EXECUTION_SLIPPAGE
  DATA_QUALITY_ISSUE
  UNKNOWN
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String?
  name           String
  role           UserRole     @default(VIEWER)
  provider       AuthProvider @default(EMAIL)
  providerId     String?
  avatar         String?
  emailVerified  Boolean      @default(false)
  otpSecret      String?
  phone          String?
  lastLogin      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  sessions    Session[]
  devices     Device[]
  trades      Trade[]
  orders      Order[]
  predictions Prediction[]
  notifications Notification[]
  portfolios  Portfolio[]
  watchlists  Watchlist[]
  auditLogs   AuditLog[]
  aiDecisions AIDecision[]

  @@index([email])
  @@index([role])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  name      String?
  type      String?
  lastIp    String?
  lastLogin DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Trade {
  id             String         @id @default(cuid())
  userId         String
  symbol         String
  direction      TradeDirection
  entry          Float
  exit           Float?
  quantity       Int
  pnl            Float?
  pnlPercent     Float?
  rr             Float?
  aiScore        Int?
  aiConfidence   Int?
  duration       Int?
  exitReason     String?
  pattern        String?
  trend          String?
  notes          String?
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  user      User       @relation(fields: [userId], references: [id])
  orders    Order[]
  journal   JournalEntry[]

  @@index([userId])
  @@index([symbol])
  @@index([openedAt])
}

model Order {
  id           String     @id @default(cuid())
  userId       String
  tradeId      String?
  symbol       String
  type         OrderType
  side         String
  quantity     Int
  price        Float?
  stopPrice    Float?
  filledQty    Int        @default(0)
  avgFillPrice Float?
  status       OrderStatus @default(PENDING)
  stopLoss     Float?
  takeProfit   Float?
  brokerOrderId String?
  brokerName   String?
  errorLog     String?
  expiresAt    DateTime?
  filledAt     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  trade Trade? @relation(fields: [tradeId], references: [id])

  @@index([userId])
  @@index([symbol])
  @@index([status])
  @@index([brokerOrderId])
}

model Prediction {
  id              Int                  @id @default(autoincrement())
  userId          String?
  symbol          String
  interval        String
  direction       PredictionDirection?
  confidence      Float?
  score           Int?
  entryZone       Float?
  stopLoss        Float?
  target          Float?
  status          PredictionStatus     @default(PENDING)
  reason          String?
  pattern         String?
  trend           String?
  riskLevel       String?
  predictedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([symbol])
  @@index([status])
  @@index([createdAt])
}

model AIDecision {
  id           String   @id @default(cuid())
  userId       String?
  symbol       String
  interval     String
  decision     String
  score        Int
  confidence   Int
  riskLevel    String
  riskScore    Int
  scoreGrade   String
  confidenceGrade String
  tradePlan    Json?
  reasoning    Json?
  warnings     Json?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([symbol])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String?
  category  String
  priority  String
  read      Boolean  @default(false)
  dismissed Boolean @default(false)
  source    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([read])
  @@index([createdAt])
}

model Portfolio {
  id            String  @id @default(cuid())
  userId        String  @unique
  capital       Float   @default(100000)
  totalPnl      Float   @default(0)
  openPositions Int     @default(0)
  closedTrades  Int     @default(0)
  winRate       Float   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  symbols   Json     @default("[]")
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model JournalEntry {
  id        String   @id @default(cuid())
  tradeId   String
  entry     Float
  exit      Float?
  direction String
  reason    String?
  aiScore   Int?
  result    String?
  notes     String?
  createdAt DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
}

model MarketDataCache {
  id        String   @id @default(cuid())
  symbol    String
  interval  String
  data      Json
  cachedAt DateTime @default(now())
  expiresAt DateTime

  @@unique([symbol, interval])
  @@index([expiresAt])
}

model ScannerResult {
  id        String   @id @default(cuid())
  symbol    String
  score     Int
  confidence Int
  risk      String
  rr        Float
  trend     String
  pattern   String?
  bias      String
  createdAt DateTime @default(now())

  @@index([symbol])
  @@index([score])
  @@index([createdAt])
}

model ReplaySession {
  id           String   @id @default(cuid())
  userId       String?
  symbol       String
  interval     String
  totalCandles Int
  currentIndex Int      @default(0)
  state        String   @default("idle")
  speed        Int      @default(1)
  createdAt    DateTime @default(now())
  finishedAt   DateTime?

  @@index([userId])
  @@index([createdAt])
}

model BacktestResult {
  id             String   @id @default(cuid())
  userId         String?
  symbol         String
  interval       String
  startDate      DateTime
  endDate        DateTime
  totalTrades    Int
  winRate        Float
  profitFactor   Float
  maxDrawdown    Float
  sharpeRatio    Float?
  totalReturn    Float
  data           Json?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  detail    Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnalyticsSnapshot {
  id        String   @id @default(cuid())
  userId    String?
  symbol    String
  type      String
  data      Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

/// ── AI Learning & Trade Feedback Loop (Phase 24) ──

model PredictionJournal {
  id                 String   @id @default(cuid())
  symbol             String
  exchange           String   @default("NSE")
  interval           String
  timestamp          DateTime @default(now())
  decision           String
  direction          String?
  score              Int
  confidence         Int
  riskScore          Int?
  riskLevel          String?
  entryPrice         Float?
  stopLoss           Float?
  target             Float?
  riskReward         Float?
  strategyId         String?
  modelId            String?
  modelVersion       String?
  marketRegime       String?
  trend              String?
  marketPhase        String?
  institutionalBias  String?
  mtfAlignment       String?
  volatility         Float?
  momentum           Float?
  featureSnapshot    Json?
  indicatorSnapshot  Json?
  patternSnapshot    Json?
  structureSnapshot  Json?
  srSnapshot         Json?
  newsContext        Json?
  marketContext      Json?
  regime             MarketRegime?
  outcome            PredictionOutcome?
  tradeFeedback      TradeFeedback?
  blockedTrade       BlockedTrade?
  userId             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id])

  @@index([symbol])
  @@index([timestamp])
  @@index([score])
  @@index([confidence])
  @@index([strategyId])
  @@index([modelId])
  @@index([regime])
}

model PredictionOutcome {
  id                    String        @id @default(cuid())
  predictionId          String        @unique
  outcome5m             String?
  outcome15m            String?
  outcome30m            String?
  outcome60m            String?
  outcomeSession        String?
  outcomeEod            String?
  maxFavorableExcursion Float?
  maxAdverseExcursion   Float?
  targetHit             Boolean?
  stopLossHit           Boolean?
  timeExit              Boolean?
  manualExit            Boolean?
  expired               Boolean?
  actualDirection       String?
  actualReturn          Float?
  maximumReturn         Float?
  maximumDrawdown       Float?
  errorCategory         ErrorCategory?
  errorReason           String?
  prediction PredictionJournal @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([predictionId])
  @@index([errorCategory])
}

model TradeFeedback {
  id               String   @id @default(cuid())
  predictionId     String   @unique
  entrySlippage    Float?
  exitSlippage     Float?
  commission       Float?
  taxes            Float?
  brokerage        Float?
  grossPnl         Float?
  netPnl           Float?
  plannedRisk      Float?
  actualRisk       Float?
  plannedRr        Float?
  actualRr         Float?
  holdingDuration  Int?
  exitReason       String?
  riskFirewallResult Json?
  strategyResult     Json?
  modelResult        Json?
  prediction PredictionJournal @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([predictionId])
  @@index([grossPnl])
}

model BlockedTrade {
  id                     String   @id @default(cuid())
  predictionId           String   @unique
  blockedBy              String
  reason                 String
  riskScore              Int?
  wouldHaveBeenProfitable Boolean?
  hypotheticalReturn      Float?
  hypotheticalRr          Float?
  actualMarketMove        Float?
  prediction PredictionJournal @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([predictionId])
  @@index([blockedBy])
}

model LearningRecommendation {
  id               String                        @id @default(cuid())
  title            String
  finding          String
  evidence         String
  sampleCount      Int
  confidence       Float
  expectedImpact   String
  risk             String
  recommendation   String
  action           String?
  category         String
  status           LearningRecommendationStatus   @default(NEW)
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  implementedAt    DateTime?
  rolledBackAt     DateTime?
  userId           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model ModelEvaluation {
  id               String   @id @default(cuid())
  modelId          String
  modelName        String
  modelVersion     Int
  modelType        String   @default("challenger")
  accuracy         Float?
  precision        Float?
  recall           Float?
  f1Score          Float?
  sharpeRatio      Float?
  winRate          Float?
  profitFactor     Float?
  maxDrawdown      Float?
  calibration      Float?
  oosAccuracy      Float?
  oosSharpe        Float?
  oosWinRate       Float?
  regimePerformance Json?
  trainedAt        DateTime?
  evaluatedAt      DateTime?
  createdAt        DateTime @default(now())

  @@index([modelId])
  @@index([modelType])
  @@index([createdAt])
}

model CalibrationBucket {
  id               String   @id @default(cuid())
  bucket           String   @unique
  bucketMin        Float
  bucketMax        Float
  totalPredictions Int      @default(0)
  correctCount     Int      @default(0)
  actualAccuracy   Float?
  averageConfidence Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([bucketMin])
}

model FeatureObservation {
  id                   String   @id @default(cuid())
  featureName          String
  importance           Float?
  correlationWithOutcome Float?
  positiveRate         Float?
  negativeRate         Float?
  winRateWhenAligned   Float?
  winRateWhenConflicting Float?
  sampleCount          Int      @default(0)
  driftScore           Float?
  observationDate      DateTime @default(now())

  @@index([featureName])
  @@index([importance])
  @@index([observationDate])
}

model ShadowPrediction {
  id                    String   @id @default(cuid())
  symbol                String
  interval              String
  timestamp             DateTime @default(now())
  championDecision      String?
  championScore         Int?
  championConfidence    Int?
  challengerDecision    String?
  challengerScore       Int?
  challengerConfidence  Int?
  actualOutcome         String?
  actualReturn          Float?
  winner                String?
  performanceDiff       Float?
  modelId               String?
  createdAt             DateTime @default(now())

  @@index([symbol])
  @@index([timestamp])
  @@index([winner])
  @@index([modelId])
}

model RegimePerformance {
  id               String        @id @default(cuid())
  regime           MarketRegime
  totalPredictions Int           @default(0)
  totalTrades      Int           @default(0)
  winRate          Float?
  averageReturn    Float?
  profitFactor     Float?
  sharpeRatio      Float?
  maxDrawdown      Float?
  confidenceAccuracy Float?
  observationDate  DateTime      @default(now())

  @@unique([regime, observationDate])
  @@index([regime])
}
