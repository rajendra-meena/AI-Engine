# MarketMind AI — Environment Configuration
# Copy this to .env and fill in your values.

# ── Server ──
MARKETMIND_HOST=0.0.0.0
MARKETMIND_PORT=8000
MARKETMIND_DEBUG=true
MARKETMIND_ENV=development
MARKETMIND_TIMEZONE=Asia/Kolkata
MARKETMIND_UTC_OFFSET=5.5

# ── Paths ──
# MARKETMIND_DB_PATH=./marketmind.db
# MARKETMIND_CACHE_DIR=./data_cache

# ── Yahoo Finance ──
# Free, no API key required.
YAHOO_REQUEST_TIMEOUT=30
YAHOO_MAX_RETRIES=3

# ── Zerodha Kite Connect ──
# Get your API key and secret from https://kite.zerodha.com/connect
# KITE_API_KEY=your_api_key
# KITE_API_SECRET=your_api_secret
# KITE_ACCESS_TOKEN=your_access_token  # Set after OAuth login

# ── Redis (optional) ──
# REDIS_URL=redis://localhost:6379
# REDIS_TTL_SECONDS=3600

# ── Paper Trading ──
PAPER_TRADING_ENABLED=true
PAPER_CAPITAL=100000

# ── Risk Defaults ──
RISK_MAX_PER_TRADE_PERCENT=1.0
RISK_MIN_RR=2.0
RISK_MAX_DAILY_LOSS_PERCENT=3.0

# ── Logging ──
MARKETMIND_LOG_LEVEL=INFO
MARKETMIND_LOG_FORMAT=text
